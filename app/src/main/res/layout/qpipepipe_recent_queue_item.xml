<?xml version="1.0" encoding="utf-8"?>
<!-- One recent queue (RecentQueuesAdapter): title, date and how far into the queue. The
     video count is on the thumbnail, as in list_playlist_mini_item.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingStart="@dimen/video_item_search_padding"
    android:paddingTop="@dimen/video_item_search_padding"
    android:paddingBottom="@dimen/video_item_search_padding">

    <FrameLayout
        android:layout_width="90dp"
        android:layout_height="50dp"
        android:layout_marginEnd="@dimen/video_item_search_image_right_margin">

        <ImageView
            android:id="@+id/recent_queue_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/dummy_thumbnail_playlist" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/recent_queue_stream_count"
            android:layout_width="45dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@color/playlist_stream_count_background_color"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:textColor="@color/duration_text_color"
            android:textSize="@dimen/video_item_search_duration_text_size"
            android:textStyle="bold"
            app:drawableTint="@color/duration_text_color"
            app:drawableTopCompat="@drawable/ic_playlist_play"
            tools:text="12" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/recent_queue_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/video_item_search_title_text_size"
            tools:text="From: Music for work" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/recent_queue_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/video_item_search_uploader_text_size"
            android:visibility="gone"
            tools:text="15/10/2026 09:05"
            tools:visibility="visible" />


        <ProgressBar
            android:id="@+id/recent_queue_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:progressDrawable="?progress_horizontal_drawable" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/recent_queue_menu"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/recent_queue_more"
        android:src="@drawable/ic_more_vert"
        app:tint="?android:attr/textColorSecondary" />
</LinearLayout>
