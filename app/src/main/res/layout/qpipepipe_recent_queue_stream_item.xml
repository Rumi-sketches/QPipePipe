<?xml version="1.0" encoding="utf-8"?>
<!-- One video of a recent queue (RecentQueueStreamsAdapter). Thumbnail, duration and watch
     bar as in list_stream_item.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="@dimen/video_item_search_padding">

    <LinearLayout
        android:layout_width="@dimen/video_item_search_thumbnail_image_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/video_item_search_image_right_margin"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/video_item_search_thumbnail_image_height">

            <ImageView
                android:id="@+id/recent_stream_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/dummy_thumbnail" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/recent_stream_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/video_item_search_duration_margin"
                android:background="@color/duration_background_color"
                android:paddingHorizontal="@dimen/video_item_search_duration_horizontal_padding"
                android:paddingVertical="@dimen/video_item_search_duration_vertical_padding"
                android:textColor="@color/duration_text_color"
                android:textSize="@dimen/video_item_search_duration_text_size"
                tools:text="8:51" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/recent_stream_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progressDrawable="?progress_horizontal_drawable"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/recent_stream_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/video_item_search_title_text_size"
            tools:text="Arcángel - FN8 (Video Lyric)" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/recent_stream_uploader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/video_item_search_uploader_text_size"
            tools:text="Arcangel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/recent_stream_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/video_item_search_uploader_text_size"
                tools:text="Playing · 3:32 of 8:51" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/recent_stream_added"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/recent_queue_added"
                android:textColor="?attr/colorAccent"
                android:textSize="@dimen/video_item_search_uploader_text_size"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
