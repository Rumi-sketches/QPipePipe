    <string name="enable_swipe_actions_warning_title">Đã bật thao tác vuốt</string>
    <string name="enable_swipe_actions_warning_message">Thao tác vuốt cần các hàng có chiều rộng đầy đủ để hoạt động ổn định, vì vậy chế độ xem danh sách sẽ được dùng thay cho chế độ lưới hoặc thẻ ở những nơi có thao tác vuốt. Bạn có thể tắt lại bất cứ lúc nào.</string>
    <string name="swipe_actions_force_list_mode_summary">Bị tắt khi thao tác vuốt đang bật, vì khi đó luôn dùng chế độ xem danh sách</string>
