<resources>
    <string name="qpipepipe_settings_summary">تایبەتمەندییەکانی ڕیز و ڕاکێشان کە ئەم لقە زیادی کردوون</string>
    <string name="qpipepipe_category_playback">لێدان</string>
    <string name="qpipepipe_category_swipe_actions">کردارەکانی ڕاکێشان</string>
    <string name="tap_always_plays_title">کرتەکردن لە ڤیدیۆ هەمیشە لێی دەدات</string>
    <string name="tap_always_plays_summary">کاتێک ڤیدیۆیەک دەکەیتەوە لێدان دەست پێ بکات، تەنانەت ئەگەر لێدانی خۆکاری تەنها بۆ Wi-Fi سنووردار کرابێت یان کوژابێتەوە. لێدانی خۆکاری هێشتا بۆ دەستپێکردنە خۆکارەکان کار دەکات</string>
    <string name="clear_queue_confirmation_title">پێش سڕینەوەی ڕیز داوای پشتڕاستکردنەوە بکە</string>
    <string name="clear_queue_confirmation_summary">گۆڕین لە کارپێکەرێکەوە بۆ یەکێکی تر لەوانەیە ڕیزەکەت بگۆڕێت</string>
    <string name="clear_queue_confirmation_description">ڕیزی کارپێکەری چالاک دەگۆڕدرێت</string>
    <string name="clear_queue_confirmation_play_now">ئێستا لێبدە</string>
    <string name="enable_swipe_actions_title">چالاککردنی کردارەکانی ڕاکێشان لەسەر ڤیدیۆکان</string>
    <string name="enable_swipe_actions_summary">ڤیدیۆیەک بەرەو چەپ یان ڕاست ڕابکێشە لە پەڕەی سەرەکی، ئەنجامەکانی گەڕان، لیستەلێدانەکان و گرووپەکانی کەناڵ بۆ ئەنجامدانی کردارێکی خێرا</string>
    <string name="swipe_left_action_title">کرداری ڕاکێشان بۆ چەپ</string>
    <string name="swipe_right_action_title">کرداری ڕاکێشان بۆ ڕاست</string>
    <string name="enable_swipe_actions_warning_title">کردارەکانی ڕاکێشان چالاک کران</string>
    <string name="enable_swipe_actions_warning_message">ڕاکێشان پێویستی بە دێڕی پانی تەواو هەیە بۆ ئەوەی بە باشی کار بکات، بۆیە لە هەر شوێنێک کردارەکانی ڕاکێشان بەردەست بن، دیمەنی خشتە لە جیاتی دیمەنی چوارخانە یان کارت بەکاردێت. هەر کاتێک بتەوێت دەتوانیت دووبارە بیکوژێنیتەوە.</string>
    <string name="swipe_actions_force_list_mode_summary">ناچالاکە تا کردارەکانی ڕاکێشان چالاکن، چونکە دیمەنی خشتە دەسەپێنن</string>
    <string name="remove_from_playlist_swipe_action">لابردن لە لیستەلێدان (تەنها لیستەلێدانەکان)</string>
