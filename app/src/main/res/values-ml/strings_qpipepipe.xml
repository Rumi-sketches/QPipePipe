<resources>
    <string name="qpipepipe_settings_summary">ഈ ഫോർക്ക് ചേർത്ത ക്യൂ, സ്വൈപ്പ് സവിശേഷതകൾ</string>
    <string name="qpipepipe_category_playback">പ്ലേബാക്ക്</string>
    <string name="qpipepipe_category_swipe_actions">സ്വൈപ്പ് പ്രവർത്തനങ്ങൾ</string>
    <string name="tap_always_plays_title">വീഡിയോയിൽ ടാപ്പ് ചെയ്താൽ എപ്പോഴും പ്ലേ ചെയ്യും</string>
    <string name="tap_always_plays_summary">വീഡിയോ തുറക്കുമ്പോൾ തന്നെ പ്ലേബാക്ക് ആരംഭിക്കുക, ഓട്ടോപ്ലേ Wi-Fi-ൽ മാത്രമായി പരിമിതപ്പെടുത്തിയാലും ഓഫാക്കിയാലും. സ്വയമേവയുള്ള തുടക്കങ്ങൾക്ക് ഓട്ടോപ്ലേ ബാധകമാണ്</string>
    <string name="clear_queue_confirmation_title">ക്യൂ മായ്ക്കുന്നതിന് മുമ്പ് സ്ഥിരീകരണം ചോദിക്കുക</string>
    <string name="clear_queue_confirmation_summary">ഒരു പ്ലെയറിൽ നിന്ന് മറ്റൊന്നിലേക്ക് മാറുമ്പോൾ നിങ്ങളുടെ ക്യൂ മാറ്റിസ്ഥാപിക്കപ്പെട്ടേക്കാം</string>
    <string name="clear_queue_confirmation_description">സജീവ പ്ലെയറിന്റെ ക്യൂ മാറ്റിസ്ഥാപിക്കും</string>
    <string name="clear_queue_confirmation_play_now">ഇപ്പോൾ പ്ലേ ചെയ്യുക</string>
    <string name="enable_swipe_actions_title">വീഡിയോകളിൽ സ്വൈപ്പ് പ്രവർത്തനങ്ങൾ ഓണാക്കുക</string>
    <string name="enable_swipe_actions_summary">ഹോംപേജ്, തിരയൽ ഫലങ്ങൾ, പ്ലേലിസ്റ്റുകൾ, ചാനൽ ഗ്രൂപ്പുകൾ എന്നിവയിൽ ഒരു വീഡിയോ ഇടത്തോട്ടോ വലത്തോട്ടോ സ്വൈപ്പ് ചെയ്ത് പെട്ടെന്നുള്ള പ്രവർത്തനം നടത്തുക</string>
    <string name="swipe_left_action_title">ഇടത് സ്വൈപ്പ് പ്രവർത്തനം</string>
    <string name="swipe_right_action_title">വലത് സ്വൈപ്പ് പ്രവർത്തനം</string>
    <string name="enable_swipe_actions_warning_title">സ്വൈപ്പ് പ്രവർത്തനങ്ങൾ ഓണാക്കി</string>
    <string name="enable_swipe_actions_warning_message">സ്വൈപ്പ് ശരിയായി പ്രവർത്തിക്കാൻ മുഴുവൻ വീതിയുള്ള വരികൾ വേണം, അതിനാൽ സ്വൈപ്പ് പ്രവർത്തനങ്ങൾ ലഭ്യമായ ഇടങ്ങളിൽ ഗ്രിഡ് അല്ലെങ്കിൽ കാർഡ് കാഴ്ചയ്ക്ക് പകരം ലിസ്റ്റ് കാഴ്ച ഉപയോഗിക്കും. ഇത് എപ്പോൾ വേണമെങ്കിലും വീണ്ടും ഓഫാക്കാം.</string>
    <string name="swipe_actions_force_list_mode_summary">സ്വൈപ്പ് പ്രവർത്തനങ്ങൾ ഓണായിരിക്കുമ്പോൾ പ്രവർത്തനരഹിതം, അവ ലിസ്റ്റ് കാഴ്ച നിർബന്ധമാക്കുന്നു</string>
    <string name="remove_from_playlist_swipe_action">പ്ലേലിസ്റ്റിൽ നിന്ന് നീക്കം ചെയ്യുക (പ്ലേലിസ്റ്റുകളിൽ മാത്രം)</string>
    <string name="qpipepipe_update_notification_title">QPipePipe %s ലഭ്യമാണ്</string>
    <string name="qpipepipe_update_notification_text">ഡൗൺലോഡ് ചെയ്ത് ഇൻസ്റ്റാൾ ചെയ്യാൻ ടാപ്പ് ചെയ്യുക</string>
    <string name="qpipepipe_update_title">QPipePipe %s</string>
    <string name="qpipepipe_update_message">ഈ അപ്ഡേറ്റ് ഡൗൺലോഡ് ചെയ്ത് ഇൻസ്റ്റാൾ ചെയ്യണോ? ഇൻസ്റ്റാളേഷൻ സ്ഥിരീകരിക്കാൻ Android ആവശ്യപ്പെടും.</string>
    <string name="qpipepipe_update_install">ഡൗൺലോഡ് ചെയ്ത് ഇൻസ്റ്റാൾ ചെയ്യുക</string>
