<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="@string/qpipepipe_settings_key"
    android:title="@string/qpipepipe_settings_title">

    <PreferenceCategory
        android:title="@string/qpipepipe_category_playback"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/tap_always_plays_key"
            android:summary="@string/tap_always_plays_summary"
            android:title="@string/tap_always_plays_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/clear_queue_confirmation_key"
            android:summary="@string/clear_queue_confirmation_summary"
            android:title="@string/clear_queue_confirmation_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/recent_queues_key"
            android:summary="@string/recent_queues_summary"
            android:title="@string/recent_queues_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/qpipepipe_category_swipe_actions"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/enable_swipe_actions_key"
            android:summary="@string/enable_swipe_actions_summary"
            android:title="@string/enable_swipe_actions_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="ENQUEUE"
            android:dependency="@string/enable_swipe_actions_key"
            android:entries="@array/swipe_action_entries"
            android:entryValues="@array/swipe_action_values"
            android:key="@string/swipe_left_action_key"
            android:title="@string/swipe_left_action_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="APPEND_PLAYLIST"
            android:dependency="@string/enable_swipe_actions_key"
            android:entries="@array/swipe_action_entries"
            android:entryValues="@array/swipe_action_values"
            android:key="@string/swipe_right_action_key"
            android:title="@string/swipe_right_action_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>
</PreferenceScreen>
