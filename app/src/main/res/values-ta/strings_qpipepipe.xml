    <string name="tap_always_plays_title">காணொலியைத் தட்டினால் எப்போதும் இயங்கும்</string>
    <string name="tap_always_plays_summary">காணொலியைத் திறந்ததும் இயக்கத் தொடங்கு, தானாக ஓட்டு Wi-Fi-க்கு மட்டும் வரம்பிடப்பட்டிருந்தாலும் அணைக்கப்பட்டிருந்தாலும் கூட. தானியங்கு தொடக்கங்களுக்கு தானாக ஓட்டு அமைப்பு பொருந்தும்</string>
    <string name="clear_queue_confirmation_title">சாரையை அழிக்கும் முன் உறுதிப்படுத்தக் கேள்</string>
    <string name="clear_queue_confirmation_summary">ஒரு இயக்கியிலிருந்து மற்றொன்றுக்கு மாறினால் உங்கள் சாரை மாற்றப்படலாம்</string>
    <string name="clear_queue_confirmation_description">செயலில் உள்ள இயக்கியின் சாரை மாற்றப்படும்</string>
    <string name="clear_queue_confirmation_play_now">இப்போது இயக்கு</string>
    <string name="enable_swipe_actions_title">காணொலிகளில் ஸ்வைப் செயல்களை இயக்கு</string>
    <string name="enable_swipe_actions_summary">முகப்புப் பக்கம், தேடல் முடிவுகள், ஒளிச்சரங்கள், அலைவரிசைக் குழுக்களில் ஒரு காணொலியை இடம் அல்லது வலம் ஸ்வைப் செய்து விரைவுச் செயலைச் செய்</string>
    <string name="swipe_left_action_title">இடது ஸ்வைப் செயல்</string>
    <string name="swipe_right_action_title">வலது ஸ்வைப் செயல்</string>
    <string name="enable_swipe_actions_warning_title">ஸ்வைப் செயல்கள் இயக்கப்பட்டன</string>
    <string name="enable_swipe_actions_warning_message">ஸ்வைப் சரியாக வேலை செய்ய முழு அகல வரிசைகள் தேவை, எனவே ஸ்வைப் செயல்கள் உள்ள இடங்களில் கட்டம் அல்லது அட்டைக் காட்சிக்குப் பதிலாகப் பட்டியல் காட்சி பயன்படுத்தப்படும். இதை எப்போது வேண்டுமானாலும் மீண்டும் அணைக்கலாம்.</string>
    <string name="swipe_actions_force_list_mode_summary">ஸ்வைப் செயல்கள் இயக்கத்தில் இருக்கும்போது முடக்கப்பட்டுள்ளது, அவை பட்டியல் காட்சியைக் கட்டாயமாக்குகின்றன</string>
